#!/usr/bin/env python3
"""Collect a privacy-safe host profile for Local Harness."""

from __future__ import annotations

import json
import os
import platform
import shutil
import subprocess
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

HOME = Path.home()
OUT = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "local-harness"
JSON_PATH = OUT / "system-profile.json"
MD_PATH = OUT / "system-profile.md"


def run(command: list[str], timeout: int = 8) -> str:
    try:
        completed = subprocess.run(command, capture_output=True, text=True, timeout=timeout)
        return (completed.stdout or "").strip()
    except Exception:
        return ""


def read(path: str) -> str:
    try:
        return Path(path).read_text(encoding="utf-8", errors="replace")
    except Exception:
        return ""


def os_release() -> dict[str, str]:
    values = {}
    for line in read("/etc/os-release").splitlines():
        if "=" in line:
            key, value = line.split("=", 1)
            values[key] = value.strip().strip('"')
    return {
        "name": values.get("NAME", "Linux"),
        "version": values.get("VERSION", ""),
        "id": values.get("ID", ""),
        "pretty": values.get("PRETTY_NAME", values.get("NAME", "Linux")),
    }


def memory() -> dict[str, float]:
    fields = {}
    for line in read("/proc/meminfo").splitlines():
        key, value = line.split(":", 1)
        fields[key] = int(value.strip().split()[0]) / 1024 / 1024
    total = fields.get("MemTotal", 0)
    available = fields.get("MemAvailable", 0)
    swap = fields.get("SwapTotal", 0)
    return {
        "total_gib": round(total, 2),
        "available_gib": round(available, 2),
        "swap_gib": round(swap, 2),
    }


def cpu() -> dict[str, object]:
    model = "unknown"
    for line in read("/proc/cpuinfo").splitlines():
        if line.lower().startswith("model name"):
            model = line.split(":", 1)[1].strip()
            break
    return {
        "model": model,
        "logical_cores": os.cpu_count() or 0,
        "architecture": platform.machine(),
    }


def gpu() -> list[str]:
    output = run(["lspci", "-nn"], timeout=5)
    return [line for line in output.splitlines() if any(key in line for key in ("VGA", "3D controller", "Display controller"))][:4]


def gpu_vram() -> list[dict[str, object]]:
    devices = []
    for device in sorted(Path("/sys/class/drm").glob("card*/device")):
        total_path = device / "mem_info_vram_total"
        if not total_path.exists():
            continue
        try:
            total = int(total_path.read_text().strip())
            used = int((device / "mem_info_vram_used").read_text().strip())
        except Exception:
            continue
        pci = Path(device.resolve()).name.removeprefix("0000:")
        devices.append({
            "pci": pci,
            "total_gib": round(total / 1024**3, 2),
            "used_gib": round(used / 1024**3, 2),
        })
    return devices


def hwmon_temp(driver: str, label: str = "temp1") -> float | None:
    for directory in Path("/sys/class/hwmon").glob("hwmon*"):
        try:
            if (directory / "name").read_text().strip() != driver:
                continue
            raw = (directory / f"{label}_input").read_text().strip()
            return round(int(raw) / 1000, 1)
        except Exception:
            continue
    return None


def gpu_temps() -> dict[str, float]:
    temps = {}
    for label in ("edge", "junction", "mem"):
        for directory in Path("/sys/class/hwmon").glob("hwmon*"):
            try:
                if (directory / "name").read_text().strip() != "amdgpu":
                    continue
                for candidate in directory.glob("temp*_label"):
                    if candidate.read_text().strip() != label:
                        continue
                    raw = candidate.with_name(candidate.name.replace("_label", "_input")).read_text().strip()
                    temps[label] = round(int(raw) / 1000, 1)
            except Exception:
                continue
    return temps


def motherboard() -> dict[str, str]:
    return {
        "vendor": read("/sys/class/dmi/id/board_vendor").strip(),
        "name": read("/sys/class/dmi/id/board_name").strip(),
    }


def llama_model() -> str:
    try:
        with urllib.request.urlopen("http://127.0.0.1:8080/v1/models", timeout=3) as response:
            data = json.loads(response.read())
        models = data.get("models") or []
        return str(models[0].get("name", "")) if models else ""
    except Exception:
        return ""


def storage() -> list[dict[str, str]]:
    output = run(["df", "-h", str(HOME)], timeout=5)
    rows = []
    for line in output.splitlines()[1:]:
        parts = line.split()
        if len(parts) >= 6:
            rows.append({
                "filesystem": parts[0],
                "size": parts[1],
                "used": parts[2],
                "available": parts[3],
                "percent": parts[4],
                "mount": parts[5],
            })
    return rows


def services() -> dict[str, str]:
    result = {}
    for unit in ("llama-server", "local-harness-flatpak"):
        result[unit] = run(["systemctl", "--user", "is-active", unit], timeout=3) or "unknown"
    return result


def tools() -> dict[str, str]:
    names = (
        "flatpak", "podman", "distrobox", "magick", "tesseract",
        "llama-server", "photocraft-cli", "python3", "node",
    )
    return {name: shutil.which(name) or "" for name in names}


def main() -> int:
    OUT.mkdir(parents=True, exist_ok=True)
    desktop = {
        "session": os.environ.get("XDG_SESSION_TYPE", ""),
        "desktop": os.environ.get("XDG_CURRENT_DESKTOP", ""),
        "display": os.environ.get("DISPLAY", ""),
        "wayland": os.environ.get("WAYLAND_DISPLAY", ""),
    }
    profile = {
        "updated_at": datetime.now(timezone.utc).isoformat(),
        "hostname": platform.node(),
        "os": os_release(),
        "kernel": platform.release(),
        "cpu": cpu(),
        "memory": memory(),
        "gpu": gpu(),
        "gpu_vram": gpu_vram(),
        "gpu_temps": gpu_temps(),
        "cpu_temp_c": hwmon_temp("k10temp", "temp1"),
        "motherboard": motherboard(),
        "llama_model": llama_model(),
        "storage": storage(),
        "desktop": desktop,
        "services": services(),
        "tools": tools(),
    }
    temp = JSON_PATH.with_suffix(".json.tmp")
    temp.write_text(json.dumps(profile, indent=2) + "\n", encoding="utf-8")
    temp.replace(JSON_PATH)

    os_info = profile["os"]
    mem = profile["memory"]
    lines = [
        "# Local Harness system profile",
        "",
        f"- Updated: {profile['updated_at']}",
        f"- Host: {profile['hostname']}",
        f"- OS: {os_info['pretty']}",
        f"- Kernel: {profile['kernel']}",
        f"- CPU: {profile['cpu']['model']} ({profile['cpu']['logical_cores']} logical cores, {profile['cpu']['architecture']})",
        f"- Memory: {mem['total_gib']} GiB total, {mem['available_gib']} GiB available, {mem['swap_gib']} GiB swap",
    ]
    if profile["gpu"]:
        lines.append("- GPU: " + " | ".join(profile["gpu"]))
    else:
        lines.append("- GPU: not detected by lspci")
    for vram in profile["gpu_vram"]:
        lines.append(f"- VRAM {vram['pci']}: {vram['total_gib']} GiB total, {vram['used_gib']} GiB used")
    if profile["gpu_temps"]:
        lines.append("- GPU temps: " + ", ".join(f"{key}={value}°C" for key, value in profile["gpu_temps"].items()))
    if profile["cpu_temp_c"] is not None:
        lines.append(f"- CPU temp: {profile['cpu_temp_c']}°C")
    if profile["motherboard"]["name"]:
        lines.append(f"- Motherboard: {profile['motherboard']['vendor']} {profile['motherboard']['name']}")
    if profile["llama_model"]:
        lines.append(f"- llama model: {profile['llama_model']}")
    for disk in profile["storage"]:
        lines.append(f"- Storage {disk['mount']}: {disk['size']} total, {disk['available']} free ({disk['percent']} used)")
    lines.append(
        "- Session: "
        + ", ".join(f"{key}={value or '-'}" for key, value in desktop.items())
    )
    lines.append("- Services: " + ", ".join(f"{key}={value}" for key, value in profile["services"].items()))
    present = [f"{name}={path}" for name, path in profile["tools"].items() if path]
    if present:
        lines.append("- Tools: " + ", ".join(present))
    lines.extend([
        "",
        "Use this as cached context. Verify live state before destructive administration.",
        "Refresh with: local-harness-system-profile",
    ])
    MD_PATH.write_text("\n".join(lines) + "\n", encoding="utf-8")
    print(MD_PATH)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
