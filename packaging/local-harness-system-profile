#!/usr/bin/env python3
"""Collect a privacy-safe host profile for Local Harness."""

from __future__ import annotations

import json
import os
import platform
import shutil
import subprocess
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

HOME = Path.home()
OUT = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "local-harness"
JSON_PATH = OUT / "system-profile.json"
MD_PATH = OUT / "system-profile.md"


def run(command: list[str], timeout: int = 8) -> str:
    try:
        completed = subprocess.run(command, capture_output=True, text=True, timeout=timeout)
        return (completed.stdout or "").strip()
    except Exception:
        return ""


def read(path: str) -> str:
    try:
        return Path(path).read_text(encoding="utf-8", errors="replace")
    except Exception:
        return ""


def os_release() -> dict[str, str]:
    values = {}
    for line in read("/etc/os-release").splitlines():
        if "=" in line:
            key, value = line.split("=", 1)
            values[key] = value.strip().strip('"')
    return {
        "name": values.get("NAME", "Linux"),
        "version": values.get("VERSION", ""),
        "id": values.get("ID", ""),
        "pretty": values.get("PRETTY_NAME", values.get("NAME", "Linux")),
    }


def memory() -> dict[str, float]:
    fields = {}
    for line in read("/proc/meminfo").splitlines():
        key, value = line.split(":", 1)
        fields[key] = int(value.strip().split()[0]) / 1024 / 1024
    total = fields.get("MemTotal", 0)
    available = fields.get("MemAvailable", 0)
    swap = fields.get("SwapTotal", 0)
    return {
        "total_gib": round(total, 2),
        "available_gib": round(available, 2),
        "swap_gib": round(swap, 2),
    }


def cpu() -> dict[str, object]:
    model = "unknown"
    for line in read("/proc/cpuinfo").splitlines():
        if line.lower().startswith("model name"):
            model = line.split(":", 1)[1].strip()
            break
    return {
        "model": model,
        "logical_cores": os.cpu_count() or 0,
        "architecture": platform.machine(),
    }


def gpu() -> list[str]:
    output = run(["lspci", "-nn"], timeout=5)
    return [line for line in output.splitlines() if any(key in line for key in ("VGA", "3D controller", "Display controller"))][:4]


def gpu_vram() -> list[dict[str, object]]:
    devices = []
    for device in sorted(Path("/sys/class/drm").glob("card*/device")):
        total_path = device / "mem_info_vram_total"
        if not total_path.exists():
            continue
        try:
            total = int(total_path.read_text().strip())
            used = int((device / "mem_info_vram_used").read_text().strip())
        except Exception:
            continue
        pci = Path(device.resolve()).name.removeprefix("0000:")
        devices.append({
            "pci": pci,
            "total_gib": round(total / 1024**3, 2),
            "used_gib": round(used / 1024**3, 2),
        })
    return devices


def hwmon_temp(driver: str, label: str = "temp1") -> float | None:
    for directory in Path("/sys/class/hwmon").glob("hwmon*"):
        try:
            if (directory / "name").read_text().strip() != driver:
                continue
            raw = (directory / f"{label}_input").read_text().strip()
            return round(int(raw) / 1000, 1)
        except Exception:
            continue
    return None


def gpu_temps() -> dict[str, float]:
    temps = {}
    for label in ("edge", "junction", "mem"):
        for directory in Path("/sys/class/hwmon").glob("hwmon*"):
            try:
                if (directory / "name").read_text().strip() != "amdgpu":
                    continue
                for candidate in directory.glob("temp*_label"):
                    if candidate.read_text().strip() != label:
                        continue
                    raw = candidate.with_name(candidate.name.replace("_label", "_input")).read_text().strip()
                    temps[label] = round(int(raw) / 1000, 1)
            except Exception:
                continue
    return temps


def motherboard() -> dict[str, str]:
    return {
        "vendor": read("/sys/class/dmi/id/board_vendor").strip(),
        "name": read("/sys/class/dmi/id/board_name").strip(),
    }


def llama_model() -> str:
    try:
        with urllib.request.urlopen("http://127.0.0.1:8080/v1/models", timeout=3) as response:
            data = json.loads(response.read())
        models = data.get("models") or []
        return str(models[0].get("name", "")) if models else ""
    except Exception:
        return ""


def storage() -> list[dict[str, str]]:
    output = run(["df", "-h", str(HOME)], timeout=5)
    rows = []
    for line in output.splitlines()[1:]:
        parts = line.split()
        if len(parts) >= 6:
            rows.append({
                "filesystem": parts[0],
                "size": parts[1],
                "used": parts[2],
                "available": parts[3],
                "percent": parts[4],
                "mount": parts[5],
            })
    return rows


def services() -> dict[str, str]:
    result = {}
    for unit in ("llama-server", "local-harness-flatpak"):
        result[unit] = run(["systemctl", "--user", "is-active", unit], timeout=3) or "unknown"
    return result


def tools() -> dict[str, str]:
    names = (
        "flatpak", "podman", "distrobox", "magick", "tesseract",
        "llama-server", "photocraft-cli", "python3", "node",
    )
    return {name: shutil.which(name) or "" for name in names}


def ostree_status() -> dict[str, object]:
    raw = run(["rpm-ostree", "status", "--json"], timeout=15)
    if not raw:
        return {"available": False}
    try:
        data = json.loads(raw)
        deployments = data.get("deployments") or []
        deployment = next((item for item in deployments if item.get("booted")), deployments[0] if deployments else {})
        return {
            "available": True,
            "origin": deployment.get("origin") or deployment.get("container-image-reference") or "",
            "version": deployment.get("version") or "",
            "commit": deployment.get("checksum") or "",
            "timestamp": deployment.get("timestamp") or "",
        }
    except Exception as error:
        return {"available": True, "error": str(error)}


def flatpak_apps() -> list[dict[str, str]]:
    output = run(["flatpak", "list", "--app", "--columns=application,name,version,origin"], timeout=12)
    apps = []
    for line in output.splitlines():
        parts = line.split("\t")
        if len(parts) >= 4:
            apps.append({"id": parts[0], "name": parts[1], "version": parts[2], "origin": parts[3]})
    return apps[:40]


def virtualization() -> dict[str, object]:
    processes = run(["ps", "-eo", "comm="], timeout=5).splitlines()
    containers = []
    for line in run(["podman", "ps", "--format", "{{.Names}}\t{{.Image}}\t{{.Status}}"], timeout=8).splitlines():
        parts = line.split("\t")
        if len(parts) >= 2:
            containers.append({"name": parts[0], "image": parts[1], "status": parts[2] if len(parts) > 2 else ""})
    vms = [line for line in run(["virsh", "list", "--all", "--name"], timeout=8).splitlines() if line.strip()]
    boxes = []
    for line in run(["distrobox", "list"], timeout=8).splitlines()[1:]:
        parts = line.split()
        if len(parts) >= 2:
            boxes.append({"name": parts[1], "status": " ".join(parts[2:4])})
    return {
        "systemd_detect_virt": run(["systemd-detect-virt"], timeout=3) or "none",
        "inside_container": Path("/run/.containerenv").exists() or Path("/.dockerenv").exists(),
        "vm_processes": [name for name in processes if name.lower() in {"qemu-system-x86_64", "qemu-kvm", "virtqemud", "libvirtd"}][:8],
        "vms": vms[:12],
        "containers": containers[:20],
        "distroboxes": boxes[:20],
    }


def photocraft_state() -> dict[str, object]:
    names = [name for name in run(["ps", "-eo", "comm="], timeout=5).splitlines() if name.lower() in {"photocraft", "photocraft-cli"}]
    appimages = []
    seen = set()
    for base in (HOME / "Applications", HOME / ".local/appimages", HOME / ".appimage", HOME / "Downloads"):
        if not base.exists():
            continue
        for pattern in ("*photocraft*", "*Photocraft*", "*.appimage", "*.AppImage"):
            for path in base.glob(pattern):
                text = str(path)
                if path.is_file() and text not in seen:
                    seen.add(text)
                    appimages.append(text)
    return {"running": names, "appimages": appimages[:20]}


def vpn_state() -> dict[str, object]:
    names = [name for name in run(["ps", "-eo", "comm="], timeout=5).splitlines()
             if name.lower() in {"pia", "pia-client", "piactl", "openvpn", "wireguard", "wg-quick"}]
    links = run(["ip", "-br", "link", "show"], timeout=5).splitlines()
    interfaces = [line.split(":")[0].strip() for line in links if any(token in line.lower() for token in ("tun", "wg", "pia"))]
    nmcli = []
    for line in run(["nmcli", "-t", "-f", "NAME,TYPE,DEVICE", "connection", "show", "--active"], timeout=5).splitlines():
        parts = line.split(":")
        if len(parts) >= 3 and any(token in parts[0].lower() for token in ("pia", "vpn", "wireguard")):
            nmcli.append({"name": parts[0], "type": parts[1], "device": parts[2]})
    default = run(["ip", "route", "show", "default"], timeout=3).splitlines()[:2]
    return {
        "pia_processes": names[:10],
        "vpn_interfaces": interfaces[:10],
        "active_vpn_connections": nmcli[:10],
        "default_routes": default,
        "pia_process_running": bool(names),
        "pia_connected": bool(interfaces or nmcli),
        "pia_active": bool(interfaces or nmcli),
    }


def ssh_targets() -> list[dict[str, str]]:
    config = HOME / ".ssh/config"
    if not config.exists():
        return []
    targets = []
    current = None
    for raw in config.read_text(encoding="utf-8", errors="replace").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split(None, 1)
        if len(parts) != 2:
            continue
        key, value = parts[0].lower(), parts[1].strip()
        if key == "host":
            for alias in value.split():
                if "*" not in alias and "?" not in alias:
                    current = {"alias": alias, "hostname": "", "user": ""}
                    targets.append(current)
        elif current is not None and key == "hostname":
            current["hostname"] = value
        elif current is not None and key == "user":
            current["user"] = value
    return targets[:20]


def main() -> int:
    OUT.mkdir(parents=True, exist_ok=True)
    desktop = {
        "session": os.environ.get("XDG_SESSION_TYPE", ""),
        "desktop": os.environ.get("XDG_CURRENT_DESKTOP", ""),
        "display": os.environ.get("DISPLAY", ""),
        "wayland": os.environ.get("WAYLAND_DISPLAY", ""),
    }
    profile = {
        "updated_at": datetime.now(timezone.utc).isoformat(),
        "hostname": platform.node(),
        "os": os_release(),
        "kernel": platform.release(),
        "cpu": cpu(),
        "memory": memory(),
        "gpu": gpu(),
        "gpu_vram": gpu_vram(),
        "gpu_temps": gpu_temps(),
        "cpu_temp_c": hwmon_temp("k10temp", "temp1"),
        "motherboard": motherboard(),
        "llama_model": llama_model(),
        "storage": storage(),
        "desktop": desktop,
        "services": services(),
        "tools": tools(),
        "ostree": ostree_status(),
        "flatpaks": flatpak_apps(),
        "virtualization": virtualization(),
        "photocraft": photocraft_state(),
        "vpn": vpn_state(),
        "ssh_targets": ssh_targets(),
    }
    temp = JSON_PATH.with_suffix(".json.tmp")
    temp.write_text(json.dumps(profile, indent=2) + "\n", encoding="utf-8")
    temp.replace(JSON_PATH)

    os_info = profile["os"]
    mem = profile["memory"]
    lines = [
        "# Local Harness system profile",
        "",
        f"- Updated: {profile['updated_at']}",
        f"- Host: {profile['hostname']}",
        f"- OS: {os_info['pretty']}",
        f"- Kernel: {profile['kernel']}",
        f"- CPU: {profile['cpu']['model']} ({profile['cpu']['logical_cores']} logical cores, {profile['cpu']['architecture']})",
        f"- Memory: {mem['total_gib']} GiB total, {mem['available_gib']} GiB available, {mem['swap_gib']} GiB swap",
    ]
    if profile["gpu"]:
        lines.append("- GPU: " + " | ".join(profile["gpu"]))
    else:
        lines.append("- GPU: not detected by lspci")
    for vram in profile["gpu_vram"]:
        lines.append(f"- VRAM {vram['pci']}: {vram['total_gib']} GiB total, {vram['used_gib']} GiB used")
    if profile["gpu_temps"]:
        lines.append("- GPU temps: " + ", ".join(f"{key}={value}°C" for key, value in profile["gpu_temps"].items()))
    if profile["cpu_temp_c"] is not None:
        lines.append(f"- CPU temp: {profile['cpu_temp_c']}°C")
    if profile["motherboard"]["name"]:
        lines.append(f"- Motherboard: {profile['motherboard']['vendor']} {profile['motherboard']['name']}")
    if profile["llama_model"]:
        lines.append(f"- llama model: {profile['llama_model']}")
    for disk in profile["storage"]:
        lines.append(f"- Storage {disk['mount']}: {disk['size']} total, {disk['available']} free ({disk['percent']} used)")
    lines.append(
        "- Session: "
        + ", ".join(f"{key}={value or '-'}" for key, value in desktop.items())
    )
    lines.append("- Services: " + ", ".join(f"{key}={value}" for key, value in profile["services"].items()))
    present = [f"{name}={path}" for name, path in profile["tools"].items() if path]
    if present:
        lines.append("- Tools: " + ", ".join(present))
    image = profile["ostree"]
    if image.get("available"):
        lines.append(f"- Immutable image: {image.get('origin') or 'unknown origin'} ({image.get('version') or 'unknown version'})")
        lines.append(f"- rpm-ostree: {'available' if shutil.which('rpm-ostree') else 'missing'}; dnf: {'available' if shutil.which('dnf') else 'missing'}")
    else:
        lines.append(f"- Package manager: dnf: {'available' if shutil.which('dnf') else 'missing'}; rpm-ostree: {'available' if shutil.which('rpm-ostree') else 'missing'}")
    if profile["flatpaks"]:
        lines.append("- Flatpaks: " + ", ".join(f"{app['name']} {app['version']}" for app in profile["flatpaks"][:10]))
    virt = profile["virtualization"]
    lines.append(
        f"- Environment: virt={virt['systemd_detect_virt']}, container={virt['inside_container']}; "
        f"VMs={len(virt['vms'])}, containers={len(virt['containers'])}, distroboxes={len(virt['distroboxes'])}"
    )
    if virt["vms"]:
        lines.append("- VM targets: " + ", ".join(virt["vms"]))
    if virt["containers"]:
        lines.append("- Containers: " + ", ".join(item["name"] for item in virt["containers"][:8]))
    pc = profile["photocraft"]
    lines.append(f"- PhotoCraft running: {', '.join(pc['running']) if pc['running'] else 'no'}")
    if pc["appimages"]:
        lines.append("- PhotoCraft AppImages: " + ", ".join(pc["appimages"][:5]))
    vpn = profile["vpn"]
    lines.append(
        f"- VPN/PIA: connected={vpn['pia_connected']}; client_running={vpn['pia_process_running']}; "
        f"processes={', '.join(vpn['pia_processes']) or '-'}; interfaces={', '.join(vpn['vpn_interfaces']) or '-'}"
    )
    if profile["ssh_targets"]:
        lines.append("- SSH targets: " + ", ".join(item["alias"] for item in profile["ssh_targets"]))
    lines.extend([
        "",
        "Use this as cached context. Verify live state before destructive administration.",
        "Refresh with: local-harness-system-profile",
    ])
    MD_PATH.write_text("\n".join(lines) + "\n", encoding="utf-8")
    print(MD_PATH)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
