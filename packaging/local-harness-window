#!/usr/bin/env python3
"""Native GTK4/WebKitGTK window for Local Harness.

Connects to the user's local-harness-flatpak service. If the service is not
running and starts are allowed, it starts the systemd unit (or launches the
Flatpak host directly as a fallback).
"""
import argparse
import atexit
import json
import os
import secrets
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "local-harness"
ENV_FILE = CONFIG_DIR / "flatpak.env"
UNIT_NAME = "local-harness-flatpak.service"
APP_ID = "org.jonathonp3.LocalHarness"


def read_env():
    port, token = 8787, None
    if ENV_FILE.exists():
        for line in ENV_FILE.read_text().splitlines():
            if line.startswith("PORT="):
                try:
                    port = int(line.split("=", 1)[1].strip())
                except ValueError:
                    pass
            elif line.startswith("TOKEN="):
                token = line.split("=", 1)[1].strip() or None
    return port, token


def health(port, timeout=1.0):
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/api/health", timeout=timeout) as response:
            return response.status == 200
    except Exception:
        return False


def wait_health(port, timeout=25.0, process=None):
    deadline = time.time() + timeout
    while time.time() < deadline:
        if process is not None and process.poll() is not None:
            return False
        if health(port):
            return True
        time.sleep(0.25)
    return False


def unit_exists():
    return (Path.home() / ".config/systemd/user" / UNIT_NAME).exists()


def start_unit():
    return subprocess.run(
        ["systemctl", "--user", "start", UNIT_NAME],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    ).returncode == 0


def spawn_direct(port, token):
    command = [
        "flatpak", "run", "--system", "--no-session-bus", "--die-with-parent",
        "--command=harness", APP_ID,
        "--workspace", str(Path.home()), "--tool-policy", "full",
        "serve", "--max-depth", "0", "--port", str(port), "--token", token,
    ]
    return subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def stop_process(process):
    if process is not None and process.poll() is None:
        process.terminate()
        try:
            process.wait(timeout=4)
        except subprocess.TimeoutExpired:
            process.kill()


def ensure_service(port, token, allow_start):
    if health(port):
        return None
    if allow_start and token and unit_exists():
        start_unit()
        if wait_health(port):
            return None
    if allow_start:
        token = token or secrets.token_hex(16)
        process = spawn_direct(port, token)
        if wait_health(port, process=process):
            return process
        stop_process(process)
    return None


def main():
    parser = argparse.ArgumentParser(description="Local Harness native window")
    parser.add_argument("--self-test", action="store_true", help="start/verify the host, print the URL, exit")
    parser.add_argument("--browser", action="store_true", help="open the UI in the default browser")
    parser.add_argument("--no-start", action="store_true", help="do not start the host if it is down")
    args = parser.parse_args()

    port, token = read_env()
    process = ensure_service(port, token, not args.no_start)
    if not health(port):
        print("Local Harness host is not running and could not be started", file=sys.stderr)
        stop_process(process)
        return 1

    url = f"http://127.0.0.1:{port}/?token={token}" if token else f"http://127.0.0.1:{port}/"
    print(url)
    atexit.register(lambda: stop_process(process))

    if args.self_test:
        stop_process(process)
        return 0
    if args.browser:
        subprocess.Popen(["xdg-open", url])
        stop_process(process)
        return 0

    import gi

    gi.require_version("Gtk", "4.0")
    gi.require_version("WebKit", "6.0")
    from gi.repository import Gtk, Gdk, WebKit

    app = Gtk.Application(application_id=f"{APP_ID}.Native")

    def on_activate(app):
        window = Gtk.ApplicationWindow(application=app, title="Local Harness")
        window.set_default_size(1100, 800)
        header = Gtk.HeaderBar()
        window.set_titlebar(header)

        manager = WebKit.UserContentManager()

        def on_clipboard_message(_manager, value):
            try:
                request = value.to_string()
            except Exception:
                return
            if request != "read":
                return
            display = Gdk.Display.get_default()
            if display is None:
                return
            clipboard = display.get_clipboard()

            def finished(source, result, _data):
                try:
                    text = source.read_text_finish(result) or ""
                except Exception:
                    text = ""
                script = "window.__harnessClipboardText(" + json.dumps(text) + ");"
                webview.evaluate_javascript(script, -1, None, None, None, None, None)

            clipboard.read_text_async(None, finished, None)

        manager.register_script_message_handler("clipboard")
        manager.connect("script-message-received::clipboard", on_clipboard_message)
        webview = WebKit.WebView(user_content_manager=manager)
        # The GTK context menu has no spelling dictionary; the page provides
        # its own menu (spelling + basic edit actions) via the DOM event.
        webview.connect("context-menu", lambda *args: True)
        webview.load_uri(url)

        reload = Gtk.Button(label="Reload")
        reload.connect("clicked", lambda _button: webview.reload())
        header.pack_start(reload)

        browser = Gtk.Button(label="Browser")
        browser.connect("clicked", lambda _button: subprocess.Popen(["xdg-open", url]))
        header.pack_end(browser)

        window.set_child(webview)
        window.present()

    app.connect("activate", on_activate)
    app.connect("shutdown", lambda _app: stop_process(process))
    app.run([])
    return 0


if __name__ == "__main__":
    sys.exit(main())
