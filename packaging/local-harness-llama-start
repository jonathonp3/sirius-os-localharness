#!/usr/bin/env python3
"""Start llama-server with the host-selected model."""
import json
import os
import sys
from pathlib import Path

HOME = Path.home()
ROOT = HOME / ".local" / "share" / "llama.cpp"
DEFAULT = ROOT / "models" / "Qwen3.5-9B-Q4_K_M.gguf"
SELECTED = HOME / ".config" / "local-harness" / "selected-model.json"

model = DEFAULT
alias = DEFAULT.stem
mmproj = None
try:
    data = json.loads(SELECTED.read_text(encoding="utf-8"))
    candidate = Path(str(data.get("path") or "")).expanduser()
    if candidate.is_file():
        model = candidate
        alias = str(data.get("alias") or candidate.stem)
        candidate_mmproj = Path(str(data.get("mmproj") or "")).expanduser()
        if candidate_mmproj.is_file():
            mmproj = candidate_mmproj
except Exception:
    pass

if not model.is_file():
    print(f"llama model not found: {model}", file=sys.stderr)
    sys.exit(1)

name = model.name.lower()
if "30b" in name:
    gpu_layers = "24"
elif "9b" in name or "7b" in name or "2b" in name:
    gpu_layers = "99"
else:
    gpu_layers = "24"

command = [
    "/usr/bin/distrobox", "enter", "--name", "llama-dev", "--no-tty", "--",
    "/usr/bin/env", f"LD_LIBRARY_PATH={ROOT / 'build' / 'bin'}",
    str(ROOT / "build" / "bin" / "llama-server"),
    "--model", str(model),
    *(["--mmproj", str(mmproj)] if mmproj else []),
    "--alias", alias,
    "--n-gpu-layers", gpu_layers,
    "--host", "127.0.0.1",
    "--port", "8080",
    "--ctx-size", "16384",
    "--device", "Vulkan0",
    "--flash-attn", "on",
    "--jinja",
    "--threads", "8",
    "--predict", "4096",
    "--parallel", "1",
    "--cors-origins", "localhost",
]
os.execv(command[0], command)
